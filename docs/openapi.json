    "/v1/suggest-scored-ingredient": {
      "get": {
        "summary": "Suggest Scored Ingredient",
        "description": "Suggest scored ingredient alternatives for an ingredient with no Agribalyse match.\n\nGiven a taxonomy id (typically one returned in ``missing_ingredient_ids``),\nwalk down the ingredients taxonomy and return the descendants that resolve\nto an Agribalyse row, so the user can pick a more specific alternative.",
        "operationId": "suggest_scored_ingredient_v1_suggest_scored_ingredient_get",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Language for the request (2 or 5 letter code)",
              "title": "Lang"
            },
            "description": "Language for the request (2 or 5 letter code)"
          },
          {
            "name": "include_synonyms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, include the synonyms of each item in the response.",
              "default": false,
              "title": "Include Synonyms"
            },
            "description": "If true, include the synonyms of each item in the response."
          },
          {
            "name": "taxonomy_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Taxonomy id of the ingredient to find alternatives for",
              "title": "Taxonomy Id"
            },
            "description": "Taxonomy id of the ingredient to find alternatives for"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestScoredIngredientResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/green-score": {
      "post": {
        "summary": "Green Score",
        "description": "Compute the green-score of a recipe given as a list of ingredients.",
        "operationId": "green_score_v1_green_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GreenScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreenScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recompute-quantity": {
      "post": {
        "summary": "Recompute Quantity",
        "description": "Recompute the quantity in grams after the user edited an ingredient's value/unit.\n\nThis is useful to let user change the value of a recipe item in a natural fashion\n(eg. change 1 egg to 3 eggs)\nwhile keeping the equivalent \"g\" conversion for green-score computation.\n\nA best effort is done to also allow changing the unit,\nbut currently, only new units that can be converted to grams are supported.\n\nUnits may be given as a taxonomy id, a localized unit name (resolved using\n``lang``) or the ``item`` sentinel for countable ingredients.",
        "operationId": "recompute_quantity_v1_recompute_quantity_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecomputeQuantityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecomputeQuantityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountedWeights": {
        "type": "string",
        "enum": [
          "scorable",
          "total"
        ],
        "title": "AccountedWeights",
        "description": "Accounted weights for the ponderated sum.\n\n* scorable takes the ratio of each ingredient compared to the total weight of ingredients that have an EF score\n* total takes the ratio of each ingredient compared to the total weight of all ingredients, including unmatched ones"
      },
      "CountriesResponse": {
        "properties": {
          "countries": {
            "items": {
              "$ref": "#/components/schemas/Country"
            },
            "type": "array",
            "title": "Countries"
          }
        },
        "type": "object",
        "required": [
          "countries"
        ],
        "title": "CountriesResponse",
        "description": "Response model for get_countries endpoint",
        "examples": [
          {
            "countries": [
              {
                "id": "en:france",
                "label": "France"
              },
              {
                "id": "en:spain",
                "label": "Spain"
              }
            ]
          }
        ]
      },
      "Country": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Taxonomy id of the item"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Name of the item"
          },
          "synonyms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synonyms",
            "description": "Synonyms in the requested language. Only present in the response when include_synonyms is true."
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code",
            "description": "ISO 3166-1 alpha-2 country code"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Country",
        "description": "Country model for Score My Recipe API",
        "examples": [
          {
            "id": "en:france",
            "label": "France",
            "synonyms": [
              "french"
            ]
          }
        ]
      },
      "GreenScoreRequest": {
        "properties": {
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/RecipeIngredientInput"
            },
            "type": "array",
            "title": "Ingredients",
            "description": "The ingredients of the recipe"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Country code (ISO 3166-1 alpha-2) to compute the distance modifier for the recipe.If not provided, the distance will always be world"
          },
          "accountedWeights": {
            "$ref": "#/components/schemas/AccountedWeights",
            "description": "Accounted weights for the ponderated sum.\n\n    * scorable takes the ratio of each ingredient compared to the total weight of ingredients that have an EF score\n    * total takes the ratio of each ingredient compared to the total weight of all ingredients, including unmatched ones\n    ",
            "default": "scorable"
          }
        },
        "type": "object",
        "required": [
          "ingredients"
        ],
        "title": "GreenScoreRequest",
        "description": "Request body for the green-score computation endpoint.\n\nIt is a thin wrapper around a list of ingredients",
        "examples": [
          {
            "accountedWeights": "scorable",
            "country": "FR",
            "ingredients": [
              {
                "codifiedIngredient": {
                  "id": "en:apple",
                  "isInTaxonomy": true,
                  "label": "Apple"
                },
                "id": "i1",
                "isInSeason": false,
                "labels": [],
                "name": "apple",
                "weight": 150
              },
              {
                "codifiedIngredient": {
                  "id": "en:wheat-flour",
                  "isInTaxonomy": true,
                  "label": "Wheat flour"
                },
                "id": "i2",
                "isInSeason": false,
                "labels": [],
                "name": "wheat flour",
                "weight": 200
              }
            ]
          }
        ]
      },
      "GreenScoreResponse": {
        "properties": {
          "globalEfScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Globalefscore",
            "description": "The computed global EF score of the recipe, null if no ingredients have a score"
          },
          "labelsBonus": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labelsbonus",
            "description": "The bonus from ingredient labels, null if no ingredients have a score, 0 if no labels"
          },
          "epiModifier": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epimodifier",
            "description": "The modifier from ingredient origin agricultural system (EPI), null if no ingredients have a score"
          },
          "distancesModifier": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distancesmodifier",
            "description": "The modifier from ingredient origin distance, null if no ingredients have a score"
          },
          "seasonalityModifier": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seasonalitymodifier",
            "description": "The modifier from ingredient seasonality, null if no ingredients have a score"
          },
          "numericScore": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Numericscore",
            "description": "The computed green-score of the recipe, null if no ingredients have a score"
          },
          "letterGrade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lettergrade",
            "description": "The letter grade corresponding to the numeric score, null if no ingredients have a score"
          },
          "missingIngredientIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missingingredientids",
            "description": "List of ingredient ids that were missing from the Agribalyse computation",
            "default": []
          },
          "notes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "Notes about the recipe-level score computation (e.g. seasonality), null when no ingredients have a score"
          },
          "ingredientsNotes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingredientsnotes",
            "description": "Per-ingredient notes keyed by ingredient id, only entries with at least one note are included, null if no ingredients have a score"
          }
        },
        "type": "object",
        "title": "GreenScoreResponse",
        "description": "Response model for the green-score computation endpoint.",
        "examples": [
          {
            "letterGrade": "A",
            "missingIngredientIds": [],
            "numericScore": 76.38
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Ingredient": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Taxonomy id of the item"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Name of the item"
          },
          "synonyms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synonyms",
            "description": "Synonyms in the requested language. Only present in the response when include_synonyms is true."
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Ingredient",
        "description": "Ingredient model for Score My Recipe API",
        "examples": [
          {
            "id": "en:apple",
            "label": "Apple",
            "synonyms": [
              "apples"
            ]
          }
        ]
      },
      "IngredientsResponse": {
        "properties": {
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            },
            "type": "array",
            "title": "Ingredients"
          }
        },
        "type": "object",
        "required": [
          "ingredients"
        ],
        "title": "IngredientsResponse",
        "description": "Response model for get_ingredients endpoint",
        "examples": [
          {
            "ingredients": [
              {
                "id": "en:apple",
                "label": "Apple"
              },
              {
                "id": "en:wheat-flour",
                "label": "Wheat flour"
              }
            ]
          }
        ]
      },
      "Label": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Taxonomy id of the item"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Name of the item"
          },
          "synonyms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synonyms",
            "description": "Synonyms in the requested language. Only present in the response when include_synonyms is true."
          }
        },
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Label",
        "description": "Label model for Score My Recipe API",
        "examples": [
          {
            "id": "en:eu-organic",
            "label": "EU Organic",
            "synonyms": [
              "bio"
            ]
          }
        ]
      },
      "LabelsResponse": {
        "properties": {
          "labels": {
            "items": {
              "$ref": "#/components/schemas/Label"
            },
            "type": "array",
            "title": "Labels"
          }
        },
        "type": "object",
        "required": [
          "labels"
        ],
        "title": "LabelsResponse",
        "description": "Response model for get_labels endpoint",
