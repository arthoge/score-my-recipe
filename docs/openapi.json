        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Language for the request (2 or 5 letter code)",
              "title": "Lang"
            },
            "description": "Language for the request (2 or 5 letter code)"
          },
          {
            "name": "include_synonyms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, include the synonyms of each item in the response.",
              "default": false,
              "title": "Include Synonyms"
            },
            "description": "If true, include the synonyms of each item in the response."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
